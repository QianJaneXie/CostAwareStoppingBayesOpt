    "                \"Regret-Gap acq\", \n",
    "                \"PRB_0.1\"\n",
    "            ]\n",
    "            \n",
    "            regret = np.array(metrics_per_acq[(a, l, cost)]['regret'])[:, :iteration_cutoff[lmbda]]\n",
